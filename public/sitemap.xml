<?xml version="1.0" encoding="UTF-8"?>
<!--
  FALLBACK uniquement. Le sitemap AUTORITAIRE est généré dynamiquement par le
  backend (GET /sitemap.xml — SitemapController) : pages statiques + contenus
  publiés (actualités, projets, événements, agenda).
  En production, Nginx route /sitemap.xml vers le backend (voir
  deploy/nginx-security.conf), ce fichier n'est alors plus servi.
-->
